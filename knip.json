{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/index.ts",
    "src/mcp/mcp-server.ts",
    "src/statusline/writer.ts",
    "src/**/index.ts",
    "src/**/*.test.ts",
    "tests/**/*.ts"
  ],
  "project": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"],
  "ignore": [
    "src/test-utils/**/*"
  ],
  "ignoreDependencies": ["prettier", "hono", "@hono/node-server", "express-rate-limit", "eslint", "husky", "lint-staged"],
  "ignoreBinaries": ["pkill", "sleep", "prettier", "knip", "dist/index.js", "gh", "caffeinate", "systemd-inhibit", "powershell", "eslint", "tsc", "husky"],
  "ignoreExportsUsedInFile": true
}
