{
  "name": "task-list",
  "description": "Incremental TaskCreate/TaskUpdate task tracking (modern dialect — TodoWrite is never emitted by real CLIs). Ids resolve through the 'Task #N created successfully' result text, like the real CLI.",
  "turns": [
    {
      "steps": [
        { "kind": "text", "text": "I'll help you with that. Let me work through these tasks." },
        { "kind": "task-create", "subject": "Analyze requirements" },
        { "kind": "task-create", "subject": "Create implementation plan" },
        { "kind": "task-create", "subject": "Execute plan" },
        { "kind": "task-update", "subject": "Analyze requirements", "status": "in_progress" },
        { "kind": "task-update", "subject": "Analyze requirements", "status": "completed", "delay": 200 },
        { "kind": "task-update", "subject": "Create implementation plan", "status": "in_progress" },
        { "kind": "task-update", "subject": "Create implementation plan", "status": "completed", "delay": 200 },
        { "kind": "task-update", "subject": "Execute plan", "status": "in_progress" },
        { "kind": "task-update", "subject": "Execute plan", "status": "completed", "delay": 200 },
        { "kind": "text", "text": "All tasks are complete!" },
        { "kind": "result", "resultText": "All tasks completed successfully." }
      ]
    }
  ]
}
